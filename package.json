{
  "name": "fixed-platform-puzzle",
  "version": "0.4.2",
  "description": "Grid-based puzzle game for Poki and CrazyGames",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "analyze": "webpack --config webpack.config.js --mode production --env analyze",
    "size": "du -sh dist/ && ls -lh dist/",
    "validate-levels": "tsx scripts/validate-levels.ts",
    "bake-levels": "tsx tools/level-generator/cli.ts generate",
    "bake-legacy": "tsx scripts/bake-legacy.ts",
    "package:poki": "tsx scripts/package.ts poki",
    "package:crazygames": "tsx scripts/package.ts crazygames",
    "package:gamedistribution": "tsx scripts/package.ts gamedistribution",
    "package:playgama": "tsx scripts/package.ts playgama",
    "package:itch": "tsx scripts/package.ts itch",
    "package:discord": "tsx scripts/package.ts discord",
    "build:discord": "webpack --config webpack.config.js --mode production --env target=discord",
    "release": "tsx scripts/release.ts",
    "test": "tsx --test tools/level-generator/tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tools/level-generator/tsconfig.json",
    "levels:evaluate": "tsx tools/level-generator/cli.ts evaluate",
    "levels:validate": "tsx tools/level-generator/cli.ts validate",
    "levels:replay": "tsx tools/level-generator/cli.ts replay",
    "levels:report": "tsx tools/level-generator/cli.ts report",
    "levels:generate": "tsx tools/level-generator/cli.ts generate",
    "levels:build": "tsx tools/level-generator/cli.ts build",
    "levels:calibrate": "tsx tools/level-generator/cli.ts calibrate",
    "levels:research": "tsx tools/level-generator/cli.ts research",
    "levels:direct": "tsx tools/level-generator/cli.ts direct",
    "levels:regression": "tsx tools/level-generator/regression.ts",
    "test:browser": "playwright test",
    "playtest": "webpack serve --config webpack.config.js --mode development --env playtest",
    "levels:playtest:build": "tsx tools/level-generator/stage-build.ts",
    "levels:reference:build": "tsx tools/level-generator/challenge-playtest.ts",
    "levels:stage:build": "tsx tools/level-generator/stage-build.ts",
    "levels:stage2:build": "tsx tools/level-generator/stage-two-build.ts",
    "levels:stage3:build": "tsx tools/level-generator/stage-three-build.ts"
  },
  "keywords": [
    "phaser",
    "puzzle",
    "game",
    "poki",
    "crazygames"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.0.0",
    "phaser": "^4.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^25.6.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "fast-check": "^4.10.2",
    "html-webpack-plugin": "^5.6.7",
    "terser-webpack-plugin": "^5.5.0",
    "ts-loader": "^9.5.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
